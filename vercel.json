{
  "framework": "vite",
  "installCommand": "bash scripts/vercel-install.sh",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/acces",
      "destination": "/index.html"
    },
    {
      "source": "/generateur",
      "destination": "/index.html"
    },
    {
      "source": "/fiches",
      "destination": "/index.html"
    },
    {
      "source": "/interactif",
      "destination": "/index.html"
    },
    {
      "source": "/interactif/:path*",
      "destination": "/index.html"
    }
  ]
}
