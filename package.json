{
  "name": "doc-prof-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "git config lfs.url https://github.com/oasi-phuoc/doc-prof.git/info/lfs >/dev/null 2>&1; git lfs pull || true; tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test tests/interactive/*.test.mjs",
    "interactive:inventory": "node scripts/interactive-inventory.mjs",
    "test:interactive:browser": "node tests/interactive/browser.mjs",
    "test:interactive:a4": "node tests/interactive/a4-regression.mjs",
    "test:interactive:saved": "node tests/interactive/saved-fiches.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "jspdf": "^4.2.1",
    "modern-screenshot": "^4.7.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.65.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
