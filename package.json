{
  "name": "doc-prof-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "git config lfs.url https://github.com/oasi-phuoc/doc-prof.git/info/lfs >/dev/null 2>&1; git lfs pull || true; tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test --test-concurrency=1 tests/interactive/*.test.mjs",
    "test:gattegno": "node scripts/audit-gattegno.cjs && node scripts/audit-gattegno-combinations.cjs && node scripts/audit-gattegno-editorial.cjs",
    "test:gattegno:browser": "node tests/interactive/gattegno-browser.mjs",
    "interactive:inventory": "node scripts/interactive-inventory.mjs",
    "test:interactive:browser": "node tests/interactive/browser.mjs",
    "test:interactive:classroom": "node tests/interactive/classroom-browser.mjs",
    "test:interactive:media": "node tests/interactive/media-browser.mjs",
    "test:interactive:a4": "node tests/interactive/a4-regression.mjs",
    "test:interactive:saved": "node tests/interactive/saved-fiches.mjs",
    "test:interactive:accessibility": "node tests/interactive/accessibility-browser.mjs",
    "test:interactive:all": "node scripts/interactive-ci.mjs",
    "test:interactive:competition": "node tests/interactive/competition-browser.mjs",
    "test:interactive:readability": "node tests/interactive/readability-browser.mjs",
    "test:interactive:audio-sequences": "node tests/interactive/audio-sequences-browser.mjs",
    "test:interactive:loading": "node tests/interactive/loading-browser.mjs",
    "test:interactive:numeracy": "node tests/interactive/numeracy-browser.mjs",
    "test:interactive:arithmetic": "node tests/interactive/written-arithmetic-browser.mjs",
    "test:interactive:ordering": "node tests/interactive/ordering-browser.mjs",
    "test:tcm-csc:browser": "node tests/interactive/tcm-csc-browser.mjs",
    "test:tcf:formats": "node tests/interactive/tcf-formats-browser.mjs",
    "test:interactive:competition-worker": "node tests/interactive/competition-worker.mjs",
    "typecheck:api": "tsc -b api/fiches/tsconfig.json",
    "check:interactive:budgets": "node scripts/interactive-budgets.mjs",
    "check:interactive:secrets": "node scripts/interactive-secrets.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "jspdf": "^4.2.1",
    "modern-screenshot": "^4.7.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.65.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
