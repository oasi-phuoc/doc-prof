# Accès fiches — mots de passe (le rôle est déduit du mot de passe)
VITE_ACCESS_ADMIN=jesuisleboss
VITE_ACCESS_FULL=jebosseplus
VITE_ACCESS_PARTIAL=synecom

# Domaines autorisés (séparés par des virgules ; ordre d’affichage géré dans access.ts)
# Alias : sante→santé, societe→société, lecture→alphabetisation, tcm_csc→tcm-csc, tcm_cfr→tcm-cfr, tcm→tpm, tcf→tpf
# FULL / PARTIAL : la liste env est la source de vérité (TCF / TCM visibles s’ils y sont).
# ADMIN : union catalogue + liste env (nouveaux domaines jamais oubliés).
VITE_ACCESS_DOMAINS_ADMIN=acm,algèbre,alphabetisation,calligraphie,gattegno,géométrie,grammaire,jeux,santé,société,soutien-fr,vocabulaire,tpf,tcf-csc,tcf-cfr,tcm-csc,tcm-cfr,tpm
VITE_ACCESS_DOMAINS_FULL=français,algèbre,géométrie,gattegno,jeux,calligraphie,soutien-fr,grammaire,vocabulaire,société,santé,tcm-cfr,tcm-csc,acm,alphabetisation,tcf-csc,tcf-cfr
VITE_ACCESS_DOMAINS_PARTIAL=algèbre,géométrie

# API fiches enregistrées (Worker Cloudflare).
VITE_FICHES_API_URL=https://clairfle-fiches.phuoc-van.workers.dev
