# Accès fiches — mots de passe (le rôle est déduit du mot de passe)
VITE_ACCESS_ADMIN=jesuisleboss
VITE_ACCESS_FULL=jebosseplus
VITE_ACCESS_PARTIAL=synecom

# Domaines autorisés (séparés par des virgules ; ordre d’affichage géré dans access.ts)
# Réguliers : algèbre,calligraphie,gattegno,géométrie,grammaire,jeux,santé,société,soutien-fr,vocabulaire
# Admin (pinés en bas) : tcf,tcm-csc,tcm-cfr,tcm
# Alias acceptés : sante→santé, societe→société, acm-csc→tcm-csc, acm-cfr→tcm-cfr
# TCM / ACM CSC / ACM CFR / TCF = réservés admin (filtrés hors FULL/PARTIAL même s’ils figurent dans l’env)
VITE_ACCESS_DOMAINS_ADMIN=algèbre,calligraphie,gattegno,géométrie,grammaire,jeux,santé,société,soutien-fr,vocabulaire,tcf,tcm-csc,tcm-cfr,tcm
VITE_ACCESS_DOMAINS_FULL=algèbre,calligraphie,gattegno,géométrie,grammaire,jeux,santé,société,soutien-fr,vocabulaire
VITE_ACCESS_DOMAINS_PARTIAL=algèbre,géométrie
